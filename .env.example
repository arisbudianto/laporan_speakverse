# Laporan staging template. Copy to .env on the hosting server only.
# Never commit real .env files or database exports.
APP_NAME=Laporan
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://laporan.speakverse.id

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=speakver_laporan
DB_USERNAME=
DB_PASSWORD=

# Keep sessions and cache isolated from SpeakVerse.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_COOKIE=laporan_session
SESSION_DOMAIN=laporan.speakverse.id
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
CACHE_PREFIX=laporan_cache_

# Do not run cloned jobs or send outbound mail before approval.
QUEUE_CONNECTION=null
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@laporan.speakverse.id
MAIL_FROM_NAME=Laporan

FILESYSTEM_DISK=local

# Review encrypted columns before generating a new APP_KEY.
# Do not run migrations, seeders, scheduler, or queue workers on production yet.
